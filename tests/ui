import { test, expect } from '@playwright/test';

test('dashboard renders and filtering works', async ({ page }) => {
  await page.goto('http://localhost:8000');

  // Main elements exist
  await expect(page.locator('#chartA')).toBeVisible();
  await expect(page.locator('#chartB')).toBeVisible();
  await expect(page.locator('#datasetSelect')).toBeVisible();

  // Check center total info text for default view (Investment Platform -> total should be visible)
  const info = page.locator('#chartA-info');
  await expect(info).toContainText('Total');

  // Ensure a swatch exists and can be toggled: find the Technology swatch
  const techSwatch = page.locator('#filterList .swatch', { hasText: 'Technology' }).first();
  await expect(techSwatch).toBeVisible();

  // Read initial opacity
  const initialOpacity = await techSwatch.evaluate((el) => window.getComputedStyle(el).opacity);

  // Click swatch to toggle off
  await techSwatch.click();

  // After toggle, opacity should reduce (or aria-pressed false)
  const afterOpacity = await techSwatch.evaluate((el) => window.getComputedStyle(el).opacity);
  const ariaPressed = await techSwatch.getAttribute('aria-pressed');

  expect(ariaPressed).toBe('false');
  expect(initialOpacity).not.toBe(afterOpacity);

  // Toggle back on via keyboard (focus + press Space)
  await techSwatch.focus();
  await page.keyboard.press('Space');
  const ariaPressed2 = await techSwatch.getAttribute('aria-pressed');
  expect(ariaPressed2).toBe('true');
});